# Azure AD / Microsoft Graph — DELEGATED (a user signs in; used for reading mail)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Microsoft Graph — APP-ONLY (client credentials; no interactive sign-in).
# Needed when a sending mailbox lives in a different Microsoft 365 tenant than
# AZURE_TENANT_ID above: such an account cannot sign in to that app registration at
# all (Microsoft returns AADSTS50020), so delegated sending is impossible for it.
# Register an app in the MAILBOX's own tenant, add the Mail.Send APPLICATION
# permission (not delegated), then click "Grant admin consent".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_SEND_AS_USER=

# App
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me

# Anthropic (on-demand AI + outreach drafts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Microsoft Graph scopes (Mail.Send required for sending outreach emails)
GRAPH_SCOPES=Mail.Read,Mail.Send,User.Read

# Production (Azure App Service) — set these on both API and Web apps
# FRONTEND_URL=https://edgeinvesting-email-contacts-web.azurewebsites.net
# AZURE_REDIRECT_URI=https://edgeinvesting-email-contacts-api.azurewebsites.net/api/v1/auth/callback
# CORS_ORIGINS=https://edgeinvesting-email-contacts-web.azurewebsites.net
# NEXT_PUBLIC_API_BASE=https://edgeinvesting-email-contacts-api.azurewebsites.net/api/v1
# DATABASE_URL=sqlite:////home/data/crm.db

# Domains (comma-separated)
INTERNAL_DOMAINS=edgeinvesting.ca,galaxypharma.com,galaxypharma.ca

# Mailboxes — JSON array of identities used for BOTH reading and sending.
# provider:
#   "microsoft_graph"     Graph via the interactive Outlook sign-in (same tenant only).
#                         Reads /me/... so only one such mailbox can be connected at a time.
#   "microsoft_graph_app" Graph app-only via the MICROSOFT_* credentials above; reads
#                         /users/{address}/... and needs NO sign-in. Use this for a mailbox in
#                         another tenant. Needs the Mail.Read AND Mail.Send application
#                         permissions. Optional per-entry overrides: "client_id" /
#                         "client_secret" / "tenant_id"
#   "gmail"               SMTP for sending, IMAP for reading — one app password covers both.
#                         IMAP must be enabled: Gmail > Settings > Forwarding and POP/IMAP.
# Generate a Gmail app password at https://myaccount.google.com/apppasswords
# Never commit real app passwords or client secrets — keep them in .env only.
OUTREACH_MAILBOXES='[{"id":"primary","label":"Primary (Outlook)","provider":"microsoft_graph","from_email":"you@yourdomain.com","from_name":"Your Name"},{"id":"other_tenant","label":"Other Tenant (Outlook)","provider":"microsoft_graph_app","from_email":"you@othertenant.com","from_name":"Your Name"},{"id":"example_gmail","label":"Example (Gmail)","provider":"gmail","from_email":"you@yourdomain.ai","from_name":"Your Name","gmail_app_password":"xxxxxxxxxxxxxxxx"}]'
